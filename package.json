{
  "name": "douala-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DOUALA AI — AI-powered browser extension translating websites from English/French into Douala, grounded in real linguistic resources.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @douala-ai/backend dev",
    "dev:extension": "pnpm --filter @douala-ai/extension dev",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "build:backend": "pnpm --filter @douala-ai/backend build",
    "build:extension": "pnpm --filter @douala-ai/extension build",
    "start:backend": "pnpm --filter @douala-ai/backend start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --no-bail test",
    "ingest": "pnpm --filter @douala-ai/backend ingest",
    "ingest:site": "pnpm --filter @douala-ai/backend ingest:site",
    "ingest:grammar": "pnpm --filter @douala-ai/backend ingest:grammar",
    "coverage:check": "pnpm --filter @douala-ai/backend coverage:check",
    "translate:sample": "pnpm --filter @douala-ai/backend translate:sample",
    "ai:test-connection": "pnpm --filter @douala-ai/backend ai:test-connection",
    "e2e:live": "node scripts/e2e-live.mjs",
    "verify": "bash scripts/verify.sh",
    "e2e:extension": "node apps/extension/e2e/real-extension.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
