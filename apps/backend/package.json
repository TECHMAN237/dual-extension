{
  "name": "@douala-ai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run",
    "ingest": "tsx --env-file-if-exists=.env src/cli/ingest.ts",
    "ai:test-connection": "tsx --env-file-if-exists=.env src/cli/test-connection.ts",
    "seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "ingest:site": "tsx --env-file-if-exists=.env src/cli/ingest-site.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@douala-ai/linguistic-knowledge": "workspace:*",
    "@douala-ai/shared": "workspace:*",
    "@douala-ai/translation-engine": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@supabase/supabase-js": "^2.86.0",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "fastify": "^5.6.2",
    "openai": "^7.55.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "pino-pretty": "^13.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
