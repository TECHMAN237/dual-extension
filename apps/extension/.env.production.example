# Copy to apps/extension/.env.production (git-ignored) before `pnpm build:extension`.
# Default backend URL baked into the extension: new installs use it, and installs that
# still point at http://localhost:8787 are moved to it once. Users can change it in Settings.
# Replace with the URL Render shows for your service (Dashboard → douala-ai-backend).
# This is a public URL, not a secret: never put API keys in VITE_ variables.
VITE_DEFAULT_BACKEND_URL=https://douala-ai-backend.onrender.com
