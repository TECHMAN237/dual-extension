# ============================================================================
# DOUALA AI — backend environment variables
# Copy this file to apps/backend/.env and fill in the values.
# NEVER commit a real .env file. NEVER put these values in the extension.
# ============================================================================

# --- AI provider ------------------------------------------------------------
# anthropic | openai | openrouter | mock
# "mock" needs no key and returns clearly labelled placeholders (not Douala).
# "openrouter" works with a free key from https://openrouter.ai/keys (see docs/AI_CONFIGURATION.md).
AI_PROVIDER=mock
# Secret key from your provider console (backend only).
AI_API_KEY=
# Capable model used for ambiguous / long segments. Leave empty for the provider default
# (anthropic: claude-opus-5-5, openai: verify the current id in the OpenAI docs,
#  openrouter: google/gemma-4-31b-it:free).
AI_MODEL=
# Fast, cheaper model for ordinary short interface strings
# (anthropic: claude-sonnet-5-5, openrouter: google/gemma-4-31b-it:free).
AI_FAST_MODEL=
# Model tried when the primary call fails
# (optional; anthropic: claude-sonnet-5-5, openrouter: google/gemma-4-26b-a4b-it:free).
AI_FALLBACK_MODEL=
# Custom API base URL for proxies / OpenAI-compatible gateways (optional).
# openrouter uses https://openrouter.ai/api/v1 when this is empty.
AI_BASE_URL=
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Segments per request / parallel requests. Empty = provider default
# (20 / 3, or 30 / 1 for openrouter because free models are rate-limited).
AI_BATCH_SIZE=
AI_CONCURRENCY=
# low | medium | high — reasoning effort hint (Anthropic output_config.effort).
AI_EFFORT=low
AI_CACHE_TTL_SECONDS=21600
# Anthropic only: route safety-declined requests to Anthropic's default fallback model (beta).
AI_ANTHROPIC_SERVER_FALLBACK=true
# strict | assisted. assisted (default): exact dictionary entries are applied directly, and the
# model may translate a text only when at least one content word has a Duala reference; other
# words stay in French as loans; every output is checked against the references.
# strict: the model returns null whenever evidence is missing. See docs/AI_CONFIGURATION.md.
TRANSLATION_MODE=assisted

# --- Supabase: NOT used (optional future storage) -----------------------------
# The normal storage is the versioned file data/knowledge/douala.json (see below).
# The Supabase code is kept for a possible future switch; leave these commented out.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# DATABASE_URL=
# Production without Supabase: the knowledge base ships with the code, live writes are
# temporary (Render's free disk is wiped on restart). Required when NODE_ENV=production.
# ALLOW_EPHEMERAL_STORAGE=true

# --- Server -----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated allowed origins. Chrome extension origins look like chrome-extension://<id>.
# "chrome-extension://*" allows any extension (fine for local dev); pin your extension id in production.
CORS_ALLOWED_ORIGINS=chrome-extension://*
# Optional shared token the extension must send (X-Douala-Client-Token). Not an AI secret.
EXTENSION_ACCESS_TOKEN=
# Required in production. Protects /api/admin/* and /api/knowledge/ingest.
ADMIN_API_TOKEN=
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_BYTES=262144

# --- Knowledge base (versioned in Git) -----------------------------------------
# Empty = data/knowledge/douala.json at the repository root (works locally and on Render).
# A relative path is resolved from the repository root. Ingestion writes this file: commit it.
LOCAL_KNOWLEDGE_FILE=
# Seed the empty UI-term list on first start (no Douala text is invented).
SEED_UI_TERMS=true
